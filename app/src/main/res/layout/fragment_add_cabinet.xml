<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:orientation="vertical"
              android:padding="16dp" android:id="@+id/item2">
    
    
    <EditText
            android:id="@+id/edittext_cabinet_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Cabinet Name"/>
    
    <EditText
            android:id="@+id/edittext_cabinet_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Cabinet Description"/>
    
    <Button
            android:id="@+id/button_add_cabinet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add Cabinet"/>
</LinearLayout>
