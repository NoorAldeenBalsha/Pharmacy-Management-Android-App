<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:orientation="vertical"
              android:padding="16dp" android:id="@+id/item7">
    
    
    <Spinner
            android:id="@+id/spinner_cabinet"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Select Cabinet"/>
    
    <Spinner
            android:id="@+id/spinner_shelf"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Select Shelf"/>
    
    <EditText
            android:id="@+id/edittext_medicine_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter Medicine Name"
            android:inputType="text"/>
    <EditText
            android:id="@+id/edittext_medicine_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter Medicine Description"
            android:inputType="text"/>
    
    <Button
            android:id="@+id/button_add_medicine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add Medicine"/>
</LinearLayout>
