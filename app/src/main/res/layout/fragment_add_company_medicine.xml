<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:orientation="vertical"
              android:padding="16dp" android:id="@+id/item5" android:visibility="visible">
    
    
    <Spinner
            android:id="@+id/spinner_company"
            android:layout_width="match_parent"
            android:layout_height="48dp"/>
    
    <EditText
            android:id="@+id/edittext_medicine_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Medicine Name"/>
    
    <EditText
            android:id="@+id/edittext_medicine_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Medicine Description"/>
    
    <Button
            android:id="@+id/button_add_medicine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add Medicine"/>
</LinearLayout>
